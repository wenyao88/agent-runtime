# ── LLM Provider (主) ──
LLM_PROVIDER=openai_compatible
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3
LLM_MAX_TOKENS=128000
LLM_TEMPERATURE=0.2

# ── LLM Provider (Judge/Summarizer, 可选) ──
JUDGE_LLM_PROVIDER=openai_compatible
JUDGE_LLM_API_KEY=sk-xxx
JUDGE_LLM_BASE_URL=https://api.siliconflow.cn/v1
JUDGE_LLM_MODEL=qwen/qwen2.5-72b-instruct

# ── Embedding ──
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# ── Database ──
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent_runtime
REDIS_URL=redis://localhost:6379/0

# ── Agent Runtime ──
AGENT_MAX_STEPS=15
AGENT_TOOL_TIMEOUT_SECONDS=30
AGENT_CONTEXT_COMPACTION_THRESHOLD=0.8
# 上下文压缩的 SUMMARIZE：超预算时先用 JUDGE_LLM 把早期对话压成摘要，而不是直接丢消息。
# 需要 JUDGE_LLM_API_KEY；关闭时超预算直接丢弃最旧消息（默认关）
AGENT_COMPACTION_SUMMARIZE_ENABLED=false

# ── GitHub Tool ──
GITHUB_TOKEN=ghp_xxx

# ── Web Search ──
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_API_KEY=

# ── Tools ──
TOOL_HTTP_TIMEOUT_SECONDS=20
TOOL_MAX_CHARS=4000

# ── Skills（技能：Markdown 定义，见 skills/ 目录）──
SKILLS_DIR=skills
AGENT_SKILL_TOP_K=1
AGENT_TASK_PLANNING_ENABLED=false

# ── Memory（三层记忆；默认全关：没起 DB/Redis 也不影响启动与任务）──
# 打开 long_term 需要 EMBEDDING_API_KEY + 已执行 `alembic upgrade head`
MEMORY_SHORT_TERM_ENABLED=false
MEMORY_LONG_TERM_ENABLED=false
MEMORY_CONSOLIDATE_ENABLED=false
MEMORY_RECALL_TOP_K=3
MEMORY_SHORT_TERM_TTL_SECONDS=86400
MEMORY_SHORT_TERM_MAX_ITEMS=200
MEMORY_INJECT_MAX_CHARS=500
# 必须与 alembic 迁移里的 vector(1024) 一致；换 embedding 模型需迁移并重算历史向量
MEMORY_EMBEDDING_DIM=1024

# ── MCP（可选；示例配置见 mcp_servers.example.json）──
MCP_SERVERS_FILE=mcp_servers.json

# ── Benchmark（Phase 6：跑任务集并产出报告）──
# 相对路径按项目根解析；报告落盘目录已 gitignore
BENCHMARK_TASKS_FILE=benchmarks/tasks.json
BENCHMARK_RUNS_DIR=benchmark_runs